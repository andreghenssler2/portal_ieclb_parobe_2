# BEGIN PORTAL IECLB v0.18.0 - feeds RSS e categorias
RewriteEngine On
RewriteRule ^(?:feed|rss)\.xml$ feed.php [L,QSA]
RewriteRule ^eventos\.feed\.xml$ feed.php [L,QSA]
RewriteRule ^(?:categoria|tag)/[a-z0-9-]+/feed\.xml$ feed.php [L,QSA]
RewriteRule ^categorias?\.sitemaps?\.xml$ sitemap.php [L,QSA]
# END PORTAL IECLB v0.18.0 - feeds RSS e categorias

# BEGIN PORTAL IECLB v0.17.0 - sitemap index e sub-sitemaps
RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^(?:geral|posts?|paginas?|eventos?|galerias?|tags?|formularios?)\.sitemaps?\.xml$ sitemap.php [L,QSA]
RewriteRule ^robots\.txt$ robots.php [L,QSA]
# END PORTAL IECLB v0.17.0 - sitemap index e sub-sitemaps

# BEGIN PORTAL_IECLB_ROTAS_V0100
RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^robots\.txt$ robots.php [L,QSA]
# END PORTAL_IECLB_ROTAS_V0100

# BEGIN PORTAL_IECLB_ROTAS_V080
RewriteEngine On

# Compatibilidade com eventual URL antiga do formulário por query string.
RewriteCond %{THE_REQUEST} \s/+[^\s?]*formulario\.php\?slug=([A-Za-z0-9-]+)(?:[&\s]) [NC]
RewriteRule ^formulario\.php$ formulario/%1 [R=301,L,NE,QSD]

# Rota pública amigável. A slug é lida do caminho pelo PHP, sem parâmetro GET.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^formulario/[A-Za-z0-9-]+/?$ formulario.php [L,NC]
# END PORTAL_IECLB_ROTAS_V080

# BEGIN PORTAL_IECLB_ROTAS_V070
RewriteEngine On

# Compatibilidade com eventual URL antiga da galeria por query string.
RewriteCond %{THE_REQUEST} \s/+[^\s?]*galeria\.php\?slug=([A-Za-z0-9-]+)(?:[&\s]) [NC]
RewriteRule ^galeria\.php$ galeria/%1 [R=301,L,NE,QSD]

# Rota pública amigável da galeria. A slug é lida da própria URL pelo PHP.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^galeria/[A-Za-z0-9-]+/?$ galeria.php [L,NC]
# END PORTAL_IECLB_ROTAS_V070

# BEGIN PORTAL_IECLB_ROTAS_V050
RewriteEngine On

# Redireciona URLs antigas com ?slug= para as novas URLs amigáveis.
RewriteCond %{THE_REQUEST} \s/+[^\s?]*noticia\.php\?slug=([A-Za-z0-9-]+)(?:[&\s]) [NC]
RewriteRule ^noticia\.php$ noticia/%1 [R=301,L,NE,QSD]

RewriteCond %{THE_REQUEST} \s/+[^\s?]*pagina\.php\?slug=([A-Za-z0-9-]+)(?:[&\s]) [NC]
RewriteRule ^pagina\.php$ pagina/%1 [R=301,L,NE,QSD]

RewriteCond %{THE_REQUEST} \s/+[^\s?]*evento\.php\?slug=([A-Za-z0-9-]+)(?:[&\s]) [NC]
RewriteRule ^evento\.php$ evento/%1 [R=301,L,NE,QSD]

# Rotas públicas amigáveis. A slug é lida da própria URL pelo PHP,
# portanto não é enviada como parâmetro GET.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^noticia/[A-Za-z0-9-]+/?$ noticia.php [L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^pagina/[A-Za-z0-9-]+/?$ pagina.php [L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^evento/[A-Za-z0-9-]+/?$ evento.php [L,NC]
# END PORTAL_IECLB_ROTAS_V050

# BEGIN PORTAL IECLB v0.12.0 - roteador de links permanentes
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.+/?$ router.php [L,QSA]
# END PORTAL IECLB v0.12.0 - roteador de links permanentes
