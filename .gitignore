# ----------------------------------------------------------------------
# Portal IECLB Parobé
# Arquivos locais, dados mutáveis e artefatos de atualização.
# ----------------------------------------------------------------------

# Configuração e segredos locais
/config/config.php
/config/config/*
php.ini
.user.ini
chaves.txt

# Dependências
/vendor/
/lib/*
!/lib/.htaccess
/lib/vendor/

# Uploads
/uploads/*
!/uploads/.gitkeep
/public/uploads/*
!/public/uploads/.gitkeep

# Storage / runtime
/storage/*
!/storage/seguranca/
!/storage/seguranca/.htaccess
!/storage/seguranca/.gitkeep

# Diretórios locais/privados históricos
/link/*
/ieclb_config/*
/ieclb-mail/*
/portal/*
/privado/*
/promocao/*
/extras/*

# Logs
*.log

# Backups e temporários
*.bak
*.bak-*
*.backup
*.tmp
*.temp

# Dumps de banco gerados localmente
/*.sql
/*.sql.gz

# Pacotes/artefatos
*.zip
_update_*
/*_v0.*.php
/LEIA-ME_v*.txt
/MANIFEST_v*.txt
/SHA256SUMS.txt

# Recursos de atualização explicitamente versionados, quando usados
!/update-resources/
/update-resources/*

# Arquivos locais diversos
.DS_Store
ads.txt
sitemap_ieclbparobe.xml
nota
notas
cgi-bin
