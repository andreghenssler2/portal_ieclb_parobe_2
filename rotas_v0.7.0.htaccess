RewriteEngine On

# Compatibilidade com eventual URL antiga da galeria por query string.
RewriteCond %{THE_REQUEST} \s/+[^\s?]*galeria\.php\?slug=([A-Za-z0-9-]+)(?:[&\s]) [NC]
RewriteRule ^galeria\.php$ galeria/%1 [R=301,L,NE,QSD]

# Rota pública amigável da galeria. A slug é lida da própria URL pelo PHP.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^galeria/[A-Za-z0-9-]+/?$ galeria.php [L,NC]
