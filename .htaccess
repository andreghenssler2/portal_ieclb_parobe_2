# BEGIN PORTAL_IECLB_ROTAS_V050
RewriteEngine On

# Redireciona URLs antigas com ?slug= para as novas URLs amigáveis.
RewriteCond %{THE_REQUEST} \s/+[^\s?]*noticia\.php\?slug=([A-Za-z0-9-]+)(?:[&\s]) [NC]
RewriteRule ^noticia\.php$ noticia/%1 [R=301,L,NE,QSD]

RewriteCond %{THE_REQUEST} \s/+[^\s?]*pagina\.php\?slug=([A-Za-z0-9-]+)(?:[&\s]) [NC]
RewriteRule ^pagina\.php$ pagina/%1 [R=301,L,NE,QSD]

RewriteCond %{THE_REQUEST} \s/+[^\s?]*evento\.php\?slug=([A-Za-z0-9-]+)(?:[&\s]) [NC]
RewriteRule ^evento\.php$ evento/%1 [R=301,L,NE,QSD]

# Rotas públicas amigáveis. A slug é lida da própria URL pelo PHP,
# portanto não é enviada como parâmetro GET.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^noticia/[A-Za-z0-9-]+/?$ noticia.php [L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^pagina/[A-Za-z0-9-]+/?$ pagina.php [L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^evento/[A-Za-z0-9-]+/?$ evento.php [L,NC]
# END PORTAL_IECLB_ROTAS_V050
